{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kieranmcshane.github.io/rating-lab/schema.json",
  "title": "Rating Lab sport payload",
  "type": "object",
  "$defs": {
    "probabilityField": {
      "type": "object",
      "required": ["probabilities", "other_probability"],
      "properties": {
        "probabilities": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "other_probability": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "resolvedScore": {
      "type": "object",
      "required": ["winner_probability", "log_loss", "brier"],
      "properties": {
        "winner_probability": { "type": "number", "minimum": 0, "maximum": 1 },
        "log_loss": { "type": "number", "minimum": 0 },
        "brier": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "marketHistory": {
      "type": "object",
      "required": [
        "captured_at",
        "snapshot_date",
        "competition_id",
        "competition_label",
        "competition_season",
        "competition_state",
        "event_id",
        "event_title",
        "event_url",
        "snapshot_sha256",
        "matched_participants",
        "model_participants",
        "coverage",
        "raw_yes_price_sum",
        "market_forecast",
        "model_forecasts",
        "execution_quotes"
      ],
      "properties": {
        "captured_at": { "type": "string" },
        "snapshot_date": { "type": "string", "format": "date" },
        "competition_id": { "type": "string" },
        "competition_label": { "type": "string" },
        "competition_season": { "type": ["string", "null"] },
        "competition_state": { "enum": ["upcoming", "live"] },
        "event_id": { "type": ["string", "null"] },
        "event_title": { "type": ["string", "null"] },
        "event_url": { "type": ["string", "null"] },
        "snapshot_sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
        "matched_participants": { "type": "integer", "minimum": 2 },
        "model_participants": { "type": "integer", "minimum": 2 },
        "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "raw_yes_price_sum": { "type": "number", "exclusiveMinimum": 0 },
        "market_forecast": { "$ref": "#/$defs/probabilityField" },
        "model_forecasts": {
          "type": "object",
          "properties": {
            "elo": { "$ref": "#/$defs/probabilityField" },
            "glicko2": { "$ref": "#/$defs/probabilityField" },
            "trueskill": { "$ref": "#/$defs/probabilityField" },
            "robust": { "$ref": "#/$defs/probabilityField" }
          },
          "additionalProperties": false
        },
        "execution_quotes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["entity_id", "market_id"],
            "properties": {
              "entity_id": { "type": "string" },
              "name": { "type": ["string", "null"] },
              "market_id": { "type": ["string", "null"] },
              "token_id": { "type": ["string", "null"] },
              "raw_yes_price": { "type": "number", "minimum": 0, "maximum": 1 },
              "best_bid": { "type": "number", "minimum": 0, "maximum": 1 },
              "best_ask": { "type": "number", "minimum": 0, "maximum": 1 },
              "top_ask_size": { "type": "number", "minimum": 0 },
              "execution_quote_status": { "type": "string" },
              "book_captured_at": { "type": "string" },
              "request_started_at": { "type": "string" },
              "response_received_at": { "type": "string" },
              "retrieval_latency_ms": { "type": "number", "minimum": 0 },
              "retrieval_url": { "type": "string" },
              "response_sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
              "provider_book_timestamp": { "type": "string" },
              "book_hash": { "type": "string" },
              "updated_at": { "type": ["string", "null"] },
              "liquidity_usd": { "type": "number", "minimum": 0 },
              "volume_usd": { "type": "number", "minimum": 0 },
              "volume_contracts": { "type": "number", "minimum": 0 },
              "fee_type": { "type": ["string", "null"] },
              "fee_multiplier": { "type": ["number", "null"], "minimum": 0 },
              "provider_base_fee_bps": { "type": ["number", "null"], "minimum": 0 },
              "taker_fee_base_rate": { "type": ["number", "null"], "minimum": 0 },
              "fee_schedule_effective_at": { "type": ["string", "null"] },
              "fee_schedule_checked_at": { "type": ["string", "null"] },
              "fee_schedule_url": { "type": ["string", "null"] },
              "fee_request_started_at": { "type": ["string", "null"] },
              "fee_response_received_at": { "type": ["string", "null"] },
              "fee_response_sha256": {
                "type": ["string", "null"],
                "minLength": 64,
                "maxLength": 64
              },
              "taker_fee_rate": { "type": ["number", "null"], "minimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "resolution": {
          "type": "object",
          "required": ["winner_id", "winner_name", "resolved_at", "scores"],
          "properties": {
            "winner_id": { "type": "string" },
            "winner_name": { "type": "string" },
            "resolved_at": { "type": ["string", "null"] },
            "scores": {
              "type": "object",
              "properties": {
                "market": { "$ref": "#/$defs/resolvedScore" },
                "elo": { "$ref": "#/$defs/resolvedScore" },
                "glicko2": { "$ref": "#/$defs/resolvedScore" },
                "trueskill": { "$ref": "#/$defs/resolvedScore" },
                "robust": { "$ref": "#/$defs/resolvedScore" }
              },
              "required": ["market"],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "marketBenchmark": {
      "type": "object",
      "required": [
        "status",
        "unit",
        "snapshots_retained",
        "scored_snapshots",
        "resolved_competitions",
        "forecasters",
        "method"
      ],
      "properties": {
        "status": { "enum": ["awaiting_resolutions", "scored"] },
        "unit": { "type": "string" },
        "snapshots_retained": { "type": "integer", "minimum": 0 },
        "scored_snapshots": { "type": "integer", "minimum": 0 },
        "resolved_competitions": { "type": "integer", "minimum": 0 },
        "forecasters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "predictions", "log_loss", "brier"],
            "properties": {
              "id": { "enum": ["market", "elo", "glicko2", "trueskill", "robust"] },
              "label": { "type": "string" },
              "predictions": { "type": "integer", "minimum": 1 },
              "log_loss": { "type": "number", "minimum": 0 },
              "brier": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "method": { "type": "string" }
      },
      "additionalProperties": false
    },
    "paperTradingAudit": {
      "type": "object",
      "required": [
        "audit_schema_version",
        "provider",
        "status",
        "strategy",
        "history_snapshots",
        "decisions",
        "positions",
        "portfolios",
        "limitations",
        "audit_sha256"
      ],
      "properties": {
        "audit_schema_version": { "type": "string" },
        "provider": { "type": "string" },
        "status": { "enum": ["collecting_executable_history", "scored"] },
        "strategy": { "type": "object" },
        "history_snapshots": { "type": "integer", "minimum": 0 },
        "decisions": { "type": "array", "items": { "type": "object" } },
        "positions": { "type": "array", "items": { "type": "object" } },
        "portfolios": { "type": "array", "items": { "type": "object" } },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "audit_sha256": { "type": "string", "minLength": 64, "maxLength": 64 }
      },
      "additionalProperties": false
    },
    "marketComparison": {
      "type": "object",
      "required": [
        "status",
        "source",
        "source_url",
        "api_base",
        "fetched_at",
        "checked_at",
        "stale_after_hours",
        "probability_definition",
        "competitions",
        "searches",
        "history",
        "benchmark",
        "paper_trading",
        "retention_policy"
      ],
      "properties": {
        "status": { "enum": ["current", "retained", "unavailable"] },
        "source": { "type": "string" },
        "source_url": { "type": "string" },
        "api_base": { "type": "string" },
        "fetched_at": { "type": ["string", "null"] },
        "checked_at": { "type": "string" },
        "stale_after_hours": { "type": "integer", "minimum": 1 },
        "probability_definition": { "type": "string" },
        "competitions": { "type": "array", "items": { "type": "object" } },
        "searches": { "type": "array", "items": { "type": "object" } },
        "history": { "type": "array", "items": { "$ref": "#/$defs/marketHistory" } },
        "benchmark": { "$ref": "#/$defs/marketBenchmark" },
        "paper_trading": { "$ref": "#/$defs/paperTradingAudit" },
        "retention_policy": { "type": "string" },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "sport",
    "generated_at",
    "latest_result",
    "source",
    "data_window",
    "outcome_context",
    "prediction_contexts",
    "eligibility",
    "competitions",
    "history_event_policy",
    "candidate_parameters",
    "parameters",
    "model_audit",
    "models",
    "evaluation_comparison",
    "incumbent_benchmarks",
    "media"
  ],
  "properties": {
    "schema_version": { "const": "1.19.0" },
    "sport": { "enum": ["tennis", "football", "national-football", "chess"] },
    "generated_at": { "type": "string" },
    "latest_result": { "type": "string", "format": "date" },
    "source": { "type": "object" },
    "data_window": {
      "type": "object",
      "required": ["first_result", "last_result", "matches", "entities"],
      "properties": {
        "first_result": { "type": "string", "format": "date" },
        "last_result": { "type": "string", "format": "date" },
        "matches": { "type": "integer", "minimum": 1 },
        "entities": { "type": "integer", "minimum": 2 }
      },
      "additionalProperties": false
    },
    "outcome_context": {
      "type": "object",
      "required": ["draw_rate", "draws", "matches", "method"],
      "properties": {
        "draw_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "draws": { "type": "integer", "minimum": 0 },
        "matches": { "type": "integer", "minimum": 1 },
        "method": { "type": "string" }
      },
      "additionalProperties": false
    },
    "prediction_contexts": {
      "type": "object",
      "required": ["type", "values", "method"],
      "properties": {
        "type": { "enum": ["surface", "venue", "color"] },
        "values": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "method": { "type": "string" }
      },
      "additionalProperties": false
    },
    "eligibility": {
      "type": "object",
      "required": ["minimum_recent_matches", "recent_window_days", "rule"]
    },
    "competitions": { "type": "array", "items": { "type": "string" } },
    "history_event_policy": {
      "type": "object",
      "required": ["scope", "method", "competition_labels"],
      "properties": {
        "scope": { "type": "string" },
        "method": { "type": "string" },
        "competition_labels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "short_label"],
            "properties": {
              "label": { "type": "string" },
              "short_label": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "candidate_parameters": { "type": "object" },
    "parameters": { "type": "object" },
    "model_audit": {
      "type": "object",
      "required": [
        "audit_schema_version",
        "status",
        "verification_level",
        "packet_url",
        "packet_sha256",
        "report_url",
        "normalized_replay_input_sha256",
        "validation_start",
        "evaluation_start",
        "selection_evidence",
        "command"
      ],
      "properties": {
        "audit_schema_version": { "const": "1.0.0" },
        "status": {
          "enum": ["packet_pending", "ready", "pass", "fail", "incomplete"]
        },
        "verification_level": {
          "enum": ["full_replay", "artifact_integrity"]
        },
        "packet_url": { "type": "string" },
        "packet_sha256": {
          "type": ["string", "null"],
          "minLength": 64,
          "maxLength": 64
        },
        "report_url": { "type": "string" },
        "normalized_replay_input_sha256": {
          "type": ["string", "null"],
          "minLength": 64,
          "maxLength": 64
        },
        "validation_start": { "type": "string", "format": "date" },
        "evaluation_start": { "type": "string", "format": "date" },
        "selection_evidence": { "type": "object" },
        "command": { "type": "string" }
      },
      "additionalProperties": false
    },
    "models": {
      "type": "object",
      "required": ["elo", "glicko2", "trueskill", "robust", "ensemble"]
    },
    "evaluation_comparison": {
      "oneOf": [
        {
          "type": "object",
          "required": ["status", "reason"],
          "properties": {
            "status": { "const": "unavailable" },
            "reason": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "status",
            "winner",
            "runner_up",
            "predictions",
            "winner_log_loss",
            "runner_up_log_loss",
            "improvement_log_loss",
            "ci95_low",
            "ci95_high",
            "interval_excludes_zero",
            "block_unit",
            "blocks",
            "resamples",
            "seed",
            "method"
          ],
          "properties": {
            "status": { "const": "available" },
            "winner": { "enum": ["elo", "glicko2", "trueskill", "robust", "ensemble"] },
            "runner_up": { "enum": ["elo", "glicko2", "trueskill", "robust", "ensemble"] },
            "predictions": { "type": "integer", "minimum": 1 },
            "winner_log_loss": { "type": "number", "minimum": 0 },
            "runner_up_log_loss": { "type": "number", "minimum": 0 },
            "improvement_log_loss": { "type": "number" },
            "ci95_low": { "type": "number" },
            "ci95_high": { "type": "number" },
            "interval_excludes_zero": { "type": "boolean" },
            "block_unit": { "const": "calendar_month" },
            "blocks": { "type": "integer", "minimum": 2 },
            "resamples": { "type": "integer", "minimum": 100 },
            "seed": { "type": "integer", "minimum": 0 },
            "method": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },
    "incumbent_benchmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "source",
          "source_url",
          "fit",
          "probability_rule",
          "common_evaluation_predictions",
          "withheld_predictions",
          "withheld_rule",
          "metrics"
        ]
      }
    },
    "coverage_evaluation": {
      "type": "object",
      "required": [
        "scope",
        "comparison",
        "tolerance",
        "all_models_non_degraded",
        "models"
      ]
    },
    "media": {
      "type": "object",
      "required": ["model_input", "policy", "fallback", "sources", "entities_with_media"],
      "properties": {
        "model_input": { "const": false },
        "policy": { "type": "string" },
        "fallback": { "type": "string" },
        "sources": { "type": "array", "items": { "type": "object" } },
        "entities_with_media": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "tournament_predictor": {
      "type": "object",
      "required": ["format", "simulations_per_model", "draw_model", "tie_break", "strengths", "knockout_draw", "availability_rule", "performance_method", "competitions"],
      "properties": {
        "format": { "type": "string" },
        "simulations_per_model": { "type": "integer", "minimum": 1 },
        "draw_model": { "type": "string" },
        "tie_break": { "type": "string" },
        "strengths": { "type": "string" },
        "knockout_draw": { "type": "string" },
        "tennis_draw": { "type": "string" },
        "availability_rule": { "type": "string" },
        "performance_method": { "type": "string" },
        "state_machine": {
          "type": "object",
          "required": ["order", "upcoming", "live", "finished"],
          "properties": {
            "order": {
              "const": ["upcoming", "live", "finished"]
            },
            "upcoming": { "type": "string" },
            "live": { "type": "string" },
            "finished": { "type": "string" }
          },
          "additionalProperties": false
        },
        "market_comparison": { "$ref": "#/$defs/marketComparison" },
        "kalshi_comparison": { "$ref": "#/$defs/marketComparison" },
        "competitions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "state": { "enum": ["upcoming", "live", "finished"] },
              "status": { "enum": ["upcoming", "live", "finished"] },
              "state_view": {
                "enum": ["prior_forecast", "conditional_forecast", "performance", "forecast_withheld"]
              },
              "forecast_available": { "type": "boolean" },
              "forecast_grace_days": { "type": "integer", "minimum": 0 },
              "forecast_as_of": { "type": "string", "format": "date" },
              "forecast_checked_at": { "type": "string", "format": "date-time" },
              "source_health": { "enum": ["current", "delayed", "incomplete"] },
              "source_health_reason": { "type": "string", "minLength": 1 },
              "completed_matches": { "type": "integer", "minimum": 0 },
              "remaining_matches": { "type": "integer", "minimum": 0 },
              "total_matches": { "type": "integer", "minimum": 0 },
              "source_reconciliation": {
                "type": "object",
                "required": ["status", "draw_final_winner_id", "result_final_winner_id", "result_rows"],
                "properties": {
                  "status": { "enum": ["draw_progress", "consistent", "result_fallback", "results_only"] },
                  "draw_final_winner_id": { "type": ["string", "null"] },
                  "result_final_winner_id": { "type": ["string", "null"] },
                  "result_rows": { "type": "integer", "minimum": 0 }
                },
                "additionalProperties": false
              }
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
